# 可选：会话加密密钥，至少 32 个字符。留空时自动生成并保存在 SQLite 中
NUXT_SESSION_PASSWORD=

# 兼容旧安装的 Resend 配置；新安装请在初始化页面配置邮件，保存后以数据库配置为准
NUXT_RESEND_API_KEY=

# 兼容旧安装的发件人配置
NUXT_MAIL_FROM="MGL Skin <onboarding@resend.dev>"

# 未通过控制台保存设置时使用的站点对外地址
NUXT_PUBLIC_SITE_URL=http://localhost:4300

# 兼容旧安装的管理员邮箱白名单，多个用逗号分隔；新安装会在初始化页面直接创建管理员
NUXT_ADMIN_EMAILS=

# SQLite 数据文件位置。生产环境务必改成绝对路径，否则从 .output/server 启动时会写进构建产物目录
NUXT_DATABASE_PATH=./.data/mgl.sqlite
