# 会话 Cookie 的加密密钥，至少 32 个字符，可用 openssl rand -base64 32 生成
NUXT_SESSION_PASSWORD=

# Resend API 密钥。留空时验证邮件与重置邮件的链接会打印到服务端控制台，便于本地开发
NUXT_RESEND_API_KEY=

# 发件人。域名未在 Resend 验证前，只能使用 onboarding@resend.dev 且只能发给账号本人的邮箱
NUXT_MAIL_FROM="MGL Skin <onboarding@resend.dev>"

# 站点对外地址，用于拼接邮件中的验证链接与重置链接
NUXT_PUBLIC_SITE_URL=http://localhost:4300

# 管理员邮箱白名单，多个用逗号分隔。白名单邮箱注册并验证后，首次登录会自动成为管理员（只升不降）
NUXT_ADMIN_EMAILS=

# SQLite 数据文件位置。生产环境务必改成绝对路径，否则从 .output/server 启动时会写进构建产物目录
NUXT_DATABASE_PATH=./.data/mgl.sqlite
